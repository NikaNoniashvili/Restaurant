<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Meta Tags -->
    <title>Restaurant - Fine Dining Experience</title>
    <meta name="description" content="Experience fine dining with our curated menu, wines, and great ambiance. Reservations available.">
    <meta name="keywords" content="restaurant, dining, menu, fine dining, reservations">

    <!-- Open Graph -->
    <meta property="og:title" content="Restaurant">
    <meta property="og:description" content="Fine dining experience">
    <meta property="og:image" content="https://restaurant.somee.com/images/hero.jpg">
    <meta property="og:url" content="https://restaurant.somee.com">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,900;1,600;1,700&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
</head>
<body>
    <div id="site-header"></div>

    <main>
        @RenderBody()
    </main>

    <div id="site-footer"></div>

    <script src="~/js/api.js"></script>
    <script src="~/js/app.js"></script>
</body>
</html>